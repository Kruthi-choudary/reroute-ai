DATABASE_URL=postgresql://user:password@host:5432/reroute
JWT_SECRET=your-long-random-secret-here
GROQ_API_KEY=your_groq_key_here
AIRLABS_API_KEY=your_airlabs_key_here

# Provider: simulated (safe default, no API calls) or airlabs (requires key)
FLIGHT_DATA_PROVIDER=simulated

# Demo protection: set a secret and pass X-Demo-Secret header to call /api/demo/* endpoints
# Leave blank to allow open access (local dev only)
DEMO_SECRET=

# Comma-separated allowed origins for CORS (no wildcards in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

MONITOR_POLL_INTERVAL_SEC=300
LOG_LEVEL=INFO
